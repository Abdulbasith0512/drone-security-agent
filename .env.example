# Copy to .env (gitignored). API keys are read from the environment (or this .env) only.
# Never commit .env and never paste a key into code, docs, cassettes or chat.

# Gemini is the optional real vision model (ingest-video --provider gemini, describe-frame).
GEMINI_API_KEY=
# Any Gemini model that supports generateContent with images; `--model` overrides this.
# If unset, the code default (see drone_agent/vision/gemini.py) is used. There is no fallback model.
GEMINI_MODEL=

# Analyst (ask / summarize --provider gemini) model, separate from the vision model above.
# Reuses GEMINI_API_KEY. If unset, the code default (drone_agent/agent/config.py) is used.
ANALYST_MODEL=
